{
  "name": "@plone/plate",
  "description": "Plone's block's editor based in Plate and Slate",
  "maintainers": [
    {
      "name": "Plone Foundation",
      "url": "https://plone.org"
    }
  ],
  "funding": "https://github.com/sponsors/plone",
  "license": "MIT",
  "version": "1.0.0-alpha.21",
  "repository": {
    "type": "git",
    "url": "https://github.com/plone/aurora.git",
    "directory": "packages/plate"
  },
  "bugs": {
    "url": "https://github.com/plone/aurora/issues"
  },
  "homepage": "https://plone.org",
  "keywords": [
    "volto",
    "plone",
    "plone6",
    "react",
    "plate",
    "slate"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "test": "vitest",
    "test:debug": "vitest --inspect-brk --watch",
    "check:ts": "tsc --project tsconfig.json",
    "dry-release": "GITHUB_TOKEN=${GITHUB_TOKEN:-$(gh auth token)} release-it --dry-run",
    "release": "GITHUB_TOKEN=${GITHUB_TOKEN:-$(gh auth token)} release-it",
    "release-major-alpha": "GITHUB_TOKEN=${GITHUB_TOKEN:-$(gh auth token)} release-it major --preRelease=alpha",
    "release-alpha": "GITHUB_TOKEN=${GITHUB_TOKEN:-$(gh auth token)} release-it --preRelease=alpha",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prettier:fix": "prettier --write '**/*.{js,jsx,ts,tsx}'",
    "lint:fix": "eslint --max-warnings=0 './**/*.{js,jsx,ts,tsx}' --fix --no-error-on-unmatched-pattern",
    "stylelint:fix": "sh -c 'if [ -f .stylelintrc ] || [ -f .stylelintrc.json ] || [ -f .stylelintrc.js ] || [ -f .stylelintrc.cjs ] || [ -f stylelint.config.js ] || [ -f stylelint.config.cjs ] || [ -f stylelint.config.mjs ]; then stylelint '''./**/*.{css,scss,less}''' --fix --allow-empty-input; else echo \"No local stylelint config, skipping\"; fi'",
    "format": "pnpm prettier:fix && pnpm lint:fix && pnpm stylelint:fix"
  },
