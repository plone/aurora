{
  "plugins": {
    "../scripts/prepublish.js": {}
  },
  "hooks": {
    "after:bump": [
      "uvx towncrier build --draft --yes --version ${version} > .changelog.draft && uvx towncrier build --yes --version ${version}",
      "pnpm build:force"
    ],
    "after:release": "rm .changelog.draft"
  },
  "npm": {
    "publish": false
  },
  "git": {
    "changelog": "uvx towncrier build --draft --yes --version 0.0.0",
    "requireUpstream": false,
    "requireCleanWorkingDir": false,
    "commitMessage": "Release @plone/react-router ${version}",
    "tagName": "plone-react-router-${version}",
    "tagAnnotation": "Release @plone/react-router ${version}"
  },
  "github": {
    "release": true,
    "releaseName": "@plone/react-router ${version}",
    "releaseNotes": "cat .changelog.draft"
  }
}
