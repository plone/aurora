{
  "extends": "tsconfig/react-library.json",
  "compilerOptions": {
    "strictPropertyInitialization": false,
    "useDefineForClassFields": true
  },
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ],
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
