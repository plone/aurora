{
  "extends": "tsconfig/react-library.json",
  "compilerOptions": {
    "strictPropertyInitialization": false,
    "paths": {}
  },
  "include": ["src/index.ts"],
  "exclude": [
    "node_modules",
    "build",
    "public",
    "coverage",
    "src/**/*.test.js",
    "src/**/*.test.jsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.js",
    "src/**/*.spec.jsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.stories.js",
    "src/**/*.stories.jsx",
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
