{
  "extends": "tsconfig/react-library.json",
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../icons/src/svg.d.ts",
    "../../apps/aurora/.react-router/types/**/*"
  ],
  "exclude": [
    "node_modules",
    "build",
    "public",
    "coverage",
    "src/**/*.test.js",
    "src/**/*.test.jsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.js",
    "src/**/*.spec.jsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.stories.js",
    "src/**/*.stories.jsx",
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx"
  ],
  "compilerOptions": {
    "types": ["vite/client"],
    "rootDirs": [
      ".",
      "../../apps/aurora/app",
      "../../apps/aurora/.react-router/types/app"
    ],
    "paths": {
      "@plone/aurora/*": ["../../apps/aurora/*"]
    }
  }
}
