{
  "name": "@plone/quanta",
  "description": "Quanta design system components for Plone Aurora",
  "maintainers": [
    {
      "name": "Plone Foundation",
      "url": "http://plone.org"
    }
  ],
  "license": "MIT",
  "version": "1.0.0-alpha.0",
  "repository": {
    "type": "git",
    "url": "http://github.com/plone/aurora.git",
    "directory": "packages/quanta"
  },
  "bugs": {
    "url": "https://github.com/plone/aurora/issues"
  },
  "type": "module",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "main": "./dist/index.js",
  "exports": {
    "./package.json": "./package.json",
    "./dist/*.css": "./dist/*.css",
    "./dist/fonts/*": "./dist/fonts/*",
    "./src/*": "./src/*",
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.cjs"
    }
  },
  "homepage": "https://plone.org",
  "keywords": [
    "plone",
    "react",
    "quanta",
    "components",
    "design-system"
  ],
  "scripts": {
    "build": "tsup && pnpm build:css",
    "build:watch": "tsup --watch && pnpm build:css",
    "build:force": "tsup && pnpm build:css",
    "build:css": "lightningcss --browserslist --bundle --sourcemap src/styles/main.css -o quanta.css && mv quanta.css* dist/. && cp -r src/styles/fonts dist/.",
    "check:exports": "attw --pack .",
    "check:ts": "tsc --project tsconfig.json",
    "test": "vitest --passWithNoTests",
    "coverage": "vitest run --coverage --no-threads",
    "lint": "pnpm eslint && pnpm prettier && pnpm stylelint && pnpm check:ts",
    "format": "pnpm prettier:fix && pnpm lint:fix && pnpm stylelint:fix",
    "eslint": "eslint 'src/**/*.{js,ts,tsx}' --quiet",
    "eslint:fix": "eslint 'src/**/*.{js,ts,tsx}' --quiet --fix",
    "prettier": "prettier --check 'src/**/*.{js,jsx,ts,tsx}'",
    "prettier:fix": "prettier --write '**/*.{js,jsx,ts,tsx}'",
    "stylelint": "stylelint 'src/**/*.{css,scss,less}'",
    "stylelint:fix": "sh -c 'if [ -f .stylelintrc ] || [ -f .stylelintrc.json ] || [ -f .stylelintrc.js ] || [ -f .stylelintrc.cjs ] || [ -f stylelint.config.js ] || [ -f stylelint.config.cjs ] || [ -f stylelint.config.mjs ]; then stylelint '''./**/*.{css,scss,less}''' --fix --allow-empty-input; else echo \"No local stylelint config, skipping\"; fi'",
    "dry-release": "GITHUB_TOKEN=${GITHUB_TOKEN:-$(gh auth token)} release-it --dry-run",
    "release": "GITHUB_TOKEN=${GITHUB_TOKEN:-$(gh auth token)} release-it",
    "release-major-alpha": "GITHUB_TOKEN=${GITHUB_TOKEN:-$(gh auth token)} release-it major --preRelease=alpha",
    "release-alpha": "GITHUB_TOKEN=${GITHUB_TOKEN:-$(gh auth token)} release-it --preRelease=alpha",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint:fix": "pnpm eslint:fix"
  },
  "publishConfig": {
    "access": "public"
  },
  "browserslist": [
    ">0.5%",
    "last 2 versions",
    "not dead"
  ],
  "dependencies": {
    "@internationalized/date": "catalog:",
    "@plone/icons": "workspace:*",
    "@react-aria/utils": "catalog:",
    "clsx": "^2.1.1",
    "react-aria": "catalog:",
    "react-aria-components": "catalog:",
    "react-stately": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwind-variants": "catalog:",
    "tailwindcss": "catalog:",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.16.4",
    "@react-types/shared": "^3.32.1",
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/addon-links": "^10.4.0",
    "@storybook/react-vite": "^10.4.0",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/jest-axe": "^3.5.7",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "browserslist": "^4.28.2",
    "eslint-plugin-storybook": "^10.4.0",
    "jest-axe": "^8.0.0",
    "jsdom": "^28.1.0",
    "lightningcss": "^1.29.0",
    "lightningcss-cli": "^1.29.1",
    "release-it": "catalog:",
    "storybook": "^10.4.0",
    "tsup": "catalog:",
    "tsconfig": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  }
}
