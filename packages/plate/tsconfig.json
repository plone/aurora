{
  "extends": "tsconfig/react-library.json",
  "include": ["**/*.ts", "**/*.tsx", "**/*.d.ts", "../icons/src/svg.d.ts"],
  "exclude": [
    "node_modules",
    "build",
    "public",
    "coverage",
    "src/**/*.test.js",
    "src/**/*.test.jsx",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.js",
    "src/**/*.spec.jsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/*.stories.js",
    "src/**/*.stories.jsx",
    "src/**/*.stories.ts",
    "src/**/*.stories.tsx"
  ],
  "compilerOptions": {
    "types": ["vite/client"],
    "paths": {
      "@plone/aurora/*": ["../../apps/aurora/*"],
      "@plone/plate/*": ["./*"],
      "@/*": ["./*"]
    }
  }
}
