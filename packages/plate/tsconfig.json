{
  "extends": "tsconfig/react-library.json",
  "include": ["**/*.ts", "**/*.tsx", "**/*.d.ts", "../icons/src/svg.d.ts"],
  "exclude": [
    "node_modules",
    "build",
    "public",
    "coverage",
    "src/**/*.test.{js,jsx,ts,tsx}",
    "src/**/*.spec.{js,jsx,ts,tsx}",
    "src/**/*.stories.{js,jsx,ts,tsx}"
  ],
  "compilerOptions": {
    "types": ["vite/client"],
    "allowImportingTsExtensions": true,
    "paths": {
      "@plone/aurora/*": ["../../apps/aurora/*"],
      "@plone/plate/*": ["./*"],
      "@/*": ["./*"]
    }
  }
}
