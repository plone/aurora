{
  "name": "@plone/aurora-dev",
  "description": "The Plone Aurora app for developing Plone Aurora itself. It is never published: projects install @plone/aurora.",
  "private": true,
  "version": "1.0.0-alpha.27",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "dev:publicui": "REGISTRYCONFIG=registry-publicui.config.ts react-router dev",
    "start": "react-router dev",
    "build": "react-router build",
    "build:publicui": "REGISTRYCONFIG=registry-publicui.config.ts react-router build",
    "start:prod": "node server.js ./build/server/index.js",
    "check:ts": "react-router typegen && tsc",
    "typecheck": "react-router typegen && tsc",
    "typegen": "react-router typegen"
  },
  "dependencies": {
    "@plone/aurora": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:"
  },
  "devDependencies": {
    "@plone/helpers": "workspace:*",
    "@plone/test-addon": "workspace:*",
    "@react-router/dev": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "catalog:",
    "vite": "catalog:"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
